# Copy to .env for local runs. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit .env.

TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
# Any long random string. Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Supabase → Connect → Transaction pooler (port 6543). Copy the host exactly from there.
# If your DB password contains @ : / ? # [ ] % or spaces, URL-encode them (@ -> %40, # -> %23, % -> %25),
# or reset the password to letters and numbers only.
DATABASE_URL=postgresql://postgres.vhunbvpsmzxvuybpxrjr:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Your Telegram user ID (ask @userinfobot). Comma-separate to add beta testers.
ALLOWED_USER_IDS=123456789

HOME_CURRENCY=SGD
DEFAULT_TIMEZONE=Asia/Singapore
LLM_DAILY_CALL_CAP=300

# M2: the Supabase scheduler sends this with every 15-minute tick (any long random string).
CRON_SECRET=change-me-too
# A single expense at or above this many SGD gets the "big spend" persona line.
BIG_EXPENSE=50
